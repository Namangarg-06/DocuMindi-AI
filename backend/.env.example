# DocuMindi-AI / Chat With Your PDF - Environment Configuration

# 1. Groq LLM API Settings
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Supported Groq Models:
# - llama-3.3-70b-versatile (Recommended: High intelligence, fast, free tier)
# - llama-3.1-8b-instant (Fastest, very lightweight)
# - mixtral-8x7b-32768
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1

# 2. Embedding Model Settings (Local, 100% Free, runs on CPU)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# 3. Document Chunking Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# 4. Retrieval Settings
TOP_K_CHUNKS=4

# 5. Session Management Settings (In-Memory, Temporary)
SESSION_TIMEOUT_MINUTES=30

# 6. Server & Security Settings
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
MAX_UPLOAD_SIZE_MB=25
